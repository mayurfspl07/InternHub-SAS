# MySQL connection (local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=internhub

# Or set a full URL instead (preferred on Railway — reference the MySQL service):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/internhub?charset=utf8mb4
# Railway may inject mysql://… — the app rewrites that to mysql+pymysql:// automatically.
# Railway MySQL plugin aliases (MYSQLHOST, MYSQLUSER, …) are also accepted.

# Required — use a long random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# Optional — password required for admin "clear database" action
# DB_CLEAR_PASSWORD=

# Server bind — Railway injects PORT automatically; APP_PORT is the local fallback
APP_HOST=0.0.0.0
APP_PORT=3001
# PORT=3001

# Public HTTPS URL of this deployment (invite links + CORS). On Railway:
# PUBLIC_SITE_URL=https://your-service.up.railway.app
PUBLIC_SITE_URL=

# Browser origins allowed to call the API (comma-separated). PUBLIC_SITE_URL is
# added automatically when set.
# CORS_ORIGINS=https://your-service.up.railway.app,http://localhost:5173

# Business timezone for attendance / shift cutoffs
# APP_TIMEZONE=Asia/Kolkata

# Persist attendance selfies across deploys (mount a Railway Volume here)
# ATTENDANCE_PHOTOS_DIR=/data/attendance_photos

# Optional path to a Vite production build if not at ../internhub frontend/dist
# FRONTEND_DIST_DIR=/app/frontend/dist

# Force Secure session cookies (defaults to on when RAILWAY_ENVIRONMENT is set)
# COOKIE_SECURE=true

# First-boot admin (change immediately after deploy)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-password
# BOOTSTRAP_ADMIN_NAME=Admin
