# Environment & secrets
# Broad match so any future variant (.env.test, .env.staging, ...) is caught
# automatically instead of needing a new line added by hand each time.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers & linters
.mypy_cache/
.ruff_cache/
.pytype/

# Databases (local dev)
instance/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# Uploaded / generated files
uploads/
media/
attendance_photos/

# Logs
*.log
logs/

# IDE & editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Uvicorn / FastAPI
*.pid

# Misc caches
.cache/
*.bak
*.tmp
